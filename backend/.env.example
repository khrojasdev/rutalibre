# Copia este archivo a backend/.env y completa con tus credenciales reales.
# backend/.env NUNCA se sube al repositorio (está en .gitignore).

# API key de openrouteservice (openrouteservice.org → dashboard → Tokens)
ORS_API_KEY=pega_aqui_tu_key

# Connection string de Neon (Neon → tu proyecto → Connection Details)
DATABASE_URL=postgresql://usuario:password@ep-xxxx.neon.tech/neondb?sslmode=require

# Orígenes permitidos por CORS (separados por coma). En desarrollo:
ALLOWED_ORIGINS=http://localhost:5173
